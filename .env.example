# Copy to .env for local development. In EasyPanel set these as service environment variables.

# --- Both services ---
# Postgres (Supabase). Empty = local SQLite file copytrade_v2.db
DATABASE_URL=
DB_CONNECT_TIMEOUT=3
# Postgres: seconds a request waits for a free pooled connection before answering 503 (SQLAlchemy default: 30)
DB_POOL_TIMEOUT=10
# json = one JSON object per line (filter by manager_id, uid...). Default: text
LOG_FORMAT=text
LOG_LEVEL=INFO
# Optional: unhandled exceptions and ERROR logs go to Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- mirror-api ---
# MIGRATE_ON_START=1 is set in the Dockerfile: the API migrates in the background once it is up
# Required, at least 32 random characters: the API refuses to start without it.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs everyone out.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
# The dashboard refreshes its token, but a login never lasts longer than this
SESSION_MAX_HOURS=12
# Other origins allowed to call the API, comma separated. Empty in production (same origin).
# Local frontend dev: CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=
# Failed logins per client IP before answering 429 until the window slides
AUTH_MAX_FAILURES=10
AUTH_FAILURE_WINDOW_SECONDS=600
# Where the API reaches the hub: use the hub's service hostname in EasyPanel (e.g. tcp://mirror-hub:5558)
HUB_EVENTS_URL=tcp://127.0.0.1:5558
HUB_HEALTH_URL=http://127.0.0.1:8001/health

# Hosted terminals (hosting.py): Fernet key that encrypts the broker passwords and license keys pods receive.
# Empty = hosting off. Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HOSTING_SECRET=

# --- mirror-hub ---
HUB_HEARTBEAT_SECONDS=5
HUB_SNAPSHOT_SECONDS=15
HUB_WARMUP_SECONDS=20
HUB_DIRECTORY_TTL_SECONDS=30
# Signals and execution reports older than this many days are deleted once a day (master_positions stays).
# 0 keeps everything; the Supabase free plan holds 500 MB.
HUB_RETENTION_DAYS=0

# --- mirror-monitor ---
# Telegram bot (@BotFather) and the chat that gets the alerts; empty = alerts only in the log
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Masters are expected connected Monday to Friday inside this window, Brasília time
MONITOR_SESSION=09:00-18:30
MONITOR_MIN_MASTERS=1
# Failed checks in a row before an alert; a check runs every MONITOR_INTERVAL_S seconds
MONITOR_FAILURES=3
MONITOR_INTERVAL_S=60
# Optional dead man's switch (e.g. healthchecks.io), called every round: alerts when the VPS itself goes down
MONITOR_PING_URL=

# --- Client accounts (clients.py) ---
# Sign-ups accepted per client IP per hour (POST /register)
SIGNUP_MAX_PER_HOUR=5
# Marketplace subscription requests per client per day (each one emails the manager)
SUBSCRIBE_MAX_PER_DAY=20

# --- Email (mailer.py): confirmation and password-reset links, subscription notices ---
# Any SMTP server (Hostinger email works). Without SMTP_HOST and SMTP_FROM nothing is sent: password reset is
# unavailable and an unconfirmed address may still subscribe. Port 465 uses SSL, any other STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Trademetric Mirror <no-reply@trademetric.com.br>
# Base of the links in the emails
PUBLIC_URL=https://mirror.trademetric.com.br
